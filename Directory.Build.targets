<Project>
  <!--
    WARNING: scripts/release.sh parses this file with grep/sed to bump
    ApplicationDisplayVersion and ApplicationVersion. If you add or move properties
    here, read the script first to make sure your changes won't break the version
    bump logic.
  -->
  <PropertyGroup>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>
</Project>
