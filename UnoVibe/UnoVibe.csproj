<Project Sdk="Uno.Sdk">
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFrameworks>net10.0-desktop;net10.0-windows10.0.26100.0</TargetFrameworks>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <PublishAot Condition="'$(TargetFramework)' != '' and $(TargetFramework.Contains('desktop')) and '$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">true</PublishAot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <ApplicationTitle>UnoVibe</ApplicationTitle>
    <ApplicationId>com.companyname.unovibe</ApplicationId>

    <ApplicationPublisher>UnoVibe</ApplicationPublisher>
    <Description>UnoVibe powered by Uno Platform.</Description>
    <UnoIconForegroundFile>Assets/Icons/UnoVibe.png</UnoIconForegroundFile>

    <UnoFeatures>
      SkiaRenderer;
      SpellChecking
    </UnoFeatures>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants Condition="'$(TargetFramework)' != '' and $(TargetFramework.Contains('windows10'))">$(DefineConstants);WASDK;WINDOWS</DefineConstants>

    <DefineConstants Condition="'$(TargetFramework)' != '' and $(TargetFramework.Contains('desktop')) and '$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">$(DefineConstants);DESKTOP_WINDOWS;WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' != '' and $(TargetFramework.Contains('desktop')) and '$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux'))">$(DefineConstants);DESKTOP_LINUX</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' != '' and $(TargetFramework.Contains('desktop')) and '$(RuntimeIdentifier)' != '' and ($(RuntimeIdentifier.StartsWith('osx')) or $(RuntimeIdentifier.StartsWith('mac')))">$(DefineConstants);DESKTOP_MACOS</DefineConstants>

    <DefineConstants Condition="'$(TargetFramework)' != '' and $(TargetFramework.Contains('desktop')) and '$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);DESKTOP_WINDOWS;WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' != '' and $(TargetFramework.Contains('desktop')) and '$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);DESKTOP_LINUX</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' != '' and $(TargetFramework.Contains('desktop')) and '$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);DESKTOP_MACOS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="./Services/SessionStoreToBeRemoved.cs" />
    <Compile Remove="./Services/OpencodeClientExtensionsToBeRemoved.cs" />
    <Compile Remove="./Services/ChatStoreToBeRemoved.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UnoVibe.Integration/UnoVibe.Integration.csproj" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="ColorCode.Core" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != '' and $(TargetFramework.Contains('windows10'))">
    <PackageReference Include="QuickMarkup.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == '' or !$(TargetFramework.Contains('windows10'))">
    <PackageReference Include="QuickMarkup.Uno" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != '' and $(TargetFramework.Contains('desktop')) and (('$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux'))) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))))">
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="Tmds.DBus.Generator" />
    <AdditionalFiles Include="Polyfills/Linux/dbus-interfaces/org.freedesktop.portal.FileChooser.xml" Namespace="UnoVibe.Polyfills.Linux.DBus" GenerateDBusTypes="true" />
    <AdditionalFiles Include="Polyfills/Linux/dbus-interfaces/org.freedesktop.portal.Request.xml" Namespace="UnoVibe.Polyfills.Linux.DBus" GenerateDBusTypes="true" />
    <AdditionalFiles Include="Polyfills/Linux/dbus-interfaces/org.freedesktop.Notifications.xml" Namespace="UnoVibe.Polyfills.Linux.DBus" GenerateDBusTypes="true" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != '' and $(TargetFramework.Contains('desktop')) and (('$(RuntimeIdentifier)' != '' and ($(RuntimeIdentifier.StartsWith('osx')) or $(RuntimeIdentifier.StartsWith('mac')))) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))))">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

</Project>
