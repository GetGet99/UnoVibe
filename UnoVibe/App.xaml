<Application x:Class="UnoVibe.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Add resources here -->

      <!-- Basically, unconstrained in regular desktop environment -->
      <x:Double x:Key="ContentDialogMaxWidth">1920</x:Double>
      <x:Double x:Key="ContentDialogMaxHeight">1920</x:Double>
      <x:Double x:Key="FlyoutThemeMaxWidth">1920</x:Double>
      <x:Double x:Key="FlyoutThemeMaxHeight">1920</x:Double>

    </ResourceDictionary>
  </Application.Resources>

</Application>
